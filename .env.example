# --- X (Twitter) API, OAuth 1.0a user context for YOUR account ---
# developer.x.com > your app > Keys and tokens. App permissions must be "Read and write"
# BEFORE you generate the Access Token, or posting returns 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- AI: any OpenAI-compatible chat completions endpoint ---
# Example (Google Gemini, has a free tier):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=<a Flash model id listed as free in AI Studio>
# Example (Groq):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=<a model id from console.groq.com>
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Supabase (free plan) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Password for the tiny control page. Use a long random string.
ADMIN_PASSWORD=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=
# Hard safety cap on posts published in any rolling 24 hours (cron + manual).
MAX_POSTS_PER_24H=4
